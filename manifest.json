{
    "name": "Youtube Playback Speed",
    "version": "1.0",
    "description": "Control Youtube Playback Speed",
    "manifest_version": 3,
    "browser_specific_settings": {
        "gecko": {
            "id": "@ytspeed"
        }
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "images/icon.png"
    },
    "icons": {
        "48": "images/icon.png",
        "96": "images/icon.png"
    },
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "js": [
                "content_script.js"
            ],
            "css": [
                "css.css"
            ]
        }
    ]
}